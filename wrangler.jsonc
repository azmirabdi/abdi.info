{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abdi-info",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "routes": [
    { "pattern": "abdi.info/*", "zone_name": "abdi.info" },
    { "pattern": "www.abdi.info/*", "zone_name": "abdi.info" }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*", "!/media/*", "!/favicon.svg"]
  }
}
