---
import Base from "../../../../layouts/Base.astro";
import PostList from "../../../../components/PostList.astro";
import { ui } from "../../../../i18n.ts";
import { publicPosts } from "../../../../lib/content.ts";

export async function getStaticPaths() {
  const posts = await publicPosts("en");
  const years = [...new Set(posts.map((post) => post.data.year))];
  return years.map((year) => ({
    params: { year: String(year) },
    props: { year, posts: posts.filter((post) => post.data.year === year) },
  }));
}
const { year, posts } = Astro.props;
const t = ui.en;
---
<Base lang="en" title={`${t.year} ${year}`} description={`${t.archiveLead} ${year}`} path={`/en/blog/${year}/`} alternatePath={`/blog/${year}/`}>
  <section class="shell page-start">
    <div class="home-column">
      <p class="kicker"><a href="/en/archive/">{t.navArchive}</a></p>
      <h1>{year}</h1>
      <PostList posts={posts} lang="en" />
    </div>
  </section>
</Base>
