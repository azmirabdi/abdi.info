---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const page = (await getCollection("legal")).find((entry) => entry.data.lang === "de" && entry.data.slug === "impressum");
if (!page) throw new Error("impressum missing");
---
<Base lang="de" title={page.data.title} description="Impressum von Azmir Abdi" path="/impressum/" alternatePath="/en/imprint/">
  <article class="legal">
    <h1>{page.data.title}</h1>
    <div class="legal-body" set:html={page.data.html} />
  </article>
</Base>
