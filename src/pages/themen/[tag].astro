---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { ui } from "../../i18n.ts";
import { publicPosts, tagName, tagPath, topicsPath } from "../../lib/content.ts";

export async function getStaticPaths() {
  const posts = await publicPosts("de");
  const ids = [...new Set(posts.flatMap((post) => post.data.tags))];
  return ids.map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
const name = tagName(tag, "de");
---
<Base lang="de" title={name} description={`${ui.de.articles}: ${name}`} path={tagPath(tag, "de")} alternatePath={`/en/topics/${tag}/`}>
  <section class="shell page-start">
    <div class="home-column">
      <p class="kicker"><a href={topicsPath("de")}>{ui.de.navTopics}</a></p>
      <h1>{name}</h1>
      <PostList posts={posts} lang="de" />
    </div>
  </section>
</Base>
