---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const page = (await getCollection("legal")).find((entry) => entry.data.lang === "de" && entry.data.slug === "datenschutzerklaerung");
if (!page) throw new Error("privacy page missing");
---
<Base lang="de" title={page.data.title} description="Datenschutzerklärung von abdi.info" path="/datenschutzerklaerung/" alternatePath="/en/privacy/">
  <article class="legal">
    <h1>{page.data.title}</h1>
    <div class="legal-body" set:html={page.data.html} />
  </article>
</Base>
