---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { ui, type Lang } from "../i18n.ts";
import {
  aboutPath,
  categoryName,
  categoryPath,
  formatDate,
  homePath,
  postPath,
  publicPosts,
  relatedPosts,
  showUpdated,
  tagName,
  tagPath,
  translationOf,
  type Post,
} from "../lib/content.ts";
import { loadImage } from "../lib/images.ts";

interface Props { post: Post }
const { post } = Astro.props;
const lang = post.data.lang as Lang;
const t = ui[lang];
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = toc.filter((heading) => heading.depth === 2).length >= 3;
const hero = await loadImage(post.data.heroImage);
const pool = await publicPosts(lang);
const related = relatedPosts(post, pool);
const alternate = await translationOf(post);
const alternatePath = alternate && "year" in alternate.data ? postPath(alternate as Post) : alternate ? aboutPath(alternate.data.lang) : undefined;
const path = postPath(post);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate,
    dateModified: post.data.updatedDate || post.data.pubDate,
    inLanguage: lang === "de" ? "de-DE" : "en-GB",
    author: { "@type": "Person", name: post.data.author, url: "https://abdi.info/about-me/" },
    mainEntityOfPage: `https://abdi.info${path}`,
    keywords: post.data.tags.join(", "),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t.navHome, item: `https://abdi.info${homePath(lang)}` },
      { "@type": "ListItem", position: 2, name: String(post.data.year), item: `https://abdi.info${lang === "en" ? "/en" : ""}/blog/${post.data.year}/` },
      { "@type": "ListItem", position: 3, name: post.data.title, item: `https://abdi.info${path}` },
    ],
  },
];
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  path={path}
  alternatePath={alternatePath}
  type="article"
  published={post.data.pubDate}
  updated={post.data.updatedDate}
  jsonLd={jsonLd}
>
  <article class="article">
    <header>
      {post.data.draft && <p class="notice">{t.draft}</p>}
      <p class="meta">
        <time datetime={post.data.pubDate}>{t.published} {formatDate(post.data.pubDate, lang)}</time>
        {showUpdated(post.data.pubDate, post.data.updatedDate) && post.data.updatedDate && (
          <> · <time datetime={post.data.updatedDate}>{t.updated} {formatDate(post.data.updatedDate, lang)}</time></>
        )}
        {" · "}{t.originalLanguage}: {post.data.originalLang === "de" ? "Deutsch" : "English"}
      </p>
      <h1>{post.data.title}</h1>
      <div class="tag-row">
        {post.data.tags.map((tag) => <a class="tag" href={tagPath(tag, lang)}>{tagName(tag, lang)}</a>)}
        {post.data.categories.map((category) => <a class="tag" href={categoryPath(category, lang)}>{categoryName(category, lang)}</a>)}
      </div>
    </header>
    {hero && (
      <Image src={hero} alt={post.data.heroAlt} widths={[720, 1200, 1600]} sizes="(min-width: 760px) 720px, 100vw" />
    )}
    {showToc && (
      <nav class="toc" aria-label={t.toc}>
        <strong>{t.toc}</strong>
        <ol>
          {toc.map((heading) => (
            <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    )}
    <div class="prose">
      <Content />
    </div>
    {related.length > 0 && (
      <section>
        <h2>{t.related}</h2>
        <ul>
          {related.map((item) => <li><a href={postPath(item)}>{item.data.title}</a></li>)}
        </ul>
      </section>
    )}
  </article>
</Base>
