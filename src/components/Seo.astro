---
import type { Lang } from "../i18n.ts";
import { absolute } from "../lib/content.ts";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternatePath?: string;
  type?: "website" | "article";
  image?: string;
  published?: string;
  updated?: string;
  jsonLd?: Record<string, unknown>[];
}
const { lang, title, description, path, alternatePath, type = "website", image, published, updated, jsonLd = [] } = Astro.props;
const canonical = absolute(path);
const fullTitle = path === "/" || path === "/en/" ? title : `${title} · Azmir Abdi`;
const dePath = lang === "de" ? path : alternatePath;
const enPath = lang === "en" ? path : alternatePath;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{dePath && <link rel="alternate" hreflang="de-DE" href={absolute(dePath)} />}
{enPath && <link rel="alternate" hreflang="en-GB" href={absolute(enPath)} />}
{dePath && <link rel="alternate" hreflang="x-default" href={absolute(dePath)} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={lang === "de" ? "de_DE" : "en_GB"} />
{dePath && lang === "en" && <meta property="og:locale:alternate" content="de_DE" />}
{enPath && lang === "de" && <meta property="og:locale:alternate" content="en_GB" />}
{image && <meta property="og:image" content={image} />}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
{published && <meta property="article:published_time" content={`${published}T12:00:00Z`} />}
{updated && <meta property="article:modified_time" content={`${updated}T12:00:00Z`} />}
{jsonLd.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
