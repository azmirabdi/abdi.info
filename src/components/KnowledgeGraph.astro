<div class="site-graph" data-graph aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-graph]");
  const canvas = root?.querySelector("canvas");
  if (!root || !canvas) throw new Error("graph missing");
  const graph = root;
  const field = canvas;
  const context = field.getContext("2d");
  if (!context) throw new Error("canvas missing");
  const pen = context;

  const band = 500;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const mobile = window.matchMedia("(max-width: 760px)").matches;
  let frame = 0;
  let running = true;

  type Node = { x: number; y: number; phase: number; spanX: number; spanY: number; turn: number };
  type Tile = { nodes: Node[]; links: [number, number][]; sparks: { link: [number, number]; offset: number }[] };
  const tiles = new Map<number, Tile>();

  function mulberry32(seed: number) {
    let state = seed >>> 0;
    return () => {
      state = (state + 0x6d2b79f5) >>> 0;
      let value = Math.imul(state ^ (state >>> 15), 1 | state);
      value = (value + Math.imul(value ^ (value >>> 7), 61 | value)) ^ value;
      return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
    };
  }

  function tile(index: number): Tile {
    const cached = tiles.get(index);
    if (cached) return cached;
    const random = mulberry32((index + 1) * 9973);
    const count = (mobile ? 8 : 14) + (Math.abs(index) % 4);
    const shift = ((Math.abs(index) % 5) - 2) * 0.14;
    const nodes = Array.from({ length: count }, () => {
      const raw = 0.1 + random() * 0.8 + shift;
      const x = index % 2 === 0 ? raw : 1 - raw;
      return {
        x: Math.min(0.92, Math.max(0.08, x)),
        y: 0.12 + random() * 0.76,
        phase: random(),
        spanX: 18 + random() * 16,
        spanY: 12 + random() * 10,
        turn: random() < 0.5 ? 1 : -1,
      };
    });
    const links: [number, number][] = [];
    nodes.forEach((node, nodeIndex) => {
      const nearest = nodes
        .map((other, otherIndex) => ({ otherIndex, distance: (other.x - node.x) ** 2 + (other.y - node.y) ** 2 }))
        .filter((item) => item.otherIndex > nodeIndex)
        .sort((a, b) => a.distance - b.distance)
        .slice(0, 2);
      nearest.forEach((item) => links.push([nodeIndex, item.otherIndex]));
    });
    const built = {
      nodes,
      links,
      sparks: links.slice(0, mobile ? 2 : 3).map((link, sparkIndex) => ({ link, offset: sparkIndex / 3 })),
    };
    tiles.set(index, built);
    return built;
  }

  function resize() {
    const rect = graph.getBoundingClientRect();
    const ratio = Math.min(window.devicePixelRatio || 1, 2);
    field.width = Math.max(1, rect.width * ratio);
    field.height = Math.max(1, rect.height * ratio);
    pen.setTransform(ratio, 0, 0, ratio, 0, 0);
  }

  function color() {
    const dark = document.documentElement.dataset.theme === "dark";
    return {
      line: dark ? "rgba(224, 138, 85, 0.28)" : "rgba(154, 78, 34, 0.22)",
      node: dark ? "rgba(246, 241, 234, 0.55)" : "rgba(20, 18, 16, 0.45)",
      spark: dark ? "rgba(227, 154, 98, 0.9)" : "rgba(198, 106, 50, 0.85)",
    };
  }

  function rectangle(progress: number, spanX: number, spanY: number) {
    const loop = ((progress % 1) + 1) % 1;
    const length = 2 * (spanX + spanY);
    let distance = loop * length;
    if (distance < spanX) return { x: distance, y: 0 };
    distance -= spanX;
    if (distance < spanY) return { x: spanX, y: distance };
    distance -= spanY;
    if (distance < spanX) return { x: spanX - distance, y: spanY };
    distance -= spanX;
    return { x: 0, y: spanY - distance };
  }

  let clock = 0;

  function draw(time = clock) {
    const width = graph.clientWidth;
    const height = graph.clientHeight;
    const scroll = window.scrollY;
    clock = time;
    pen.clearRect(0, 0, width, height);
    const palette = color();
    const first = Math.floor(scroll / band);
    const last = Math.floor((scroll + height) / band);
    for (let index = first; index <= last; index += 1) {
      const layer = tile(index);
      const top = index * band - scroll;
      const point = (nodeIndex: number) => {
        const node = layer.nodes[nodeIndex];
        const drift = reduced
          ? { x: node.spanX / 2, y: node.spanY / 2 }
          : rectangle(time / 36000 * node.turn + node.phase, node.spanX, node.spanY);
        return {
          x: node.x * width + drift.x - node.spanX / 2,
          y: top + node.y * band + drift.y - node.spanY / 2,
        };
      };
      pen.lineWidth = 1;
      pen.strokeStyle = palette.line;
      layer.links.forEach(([from, to]) => {
        const a = point(from);
        const b = point(to);
        pen.beginPath();
        pen.moveTo(a.x, a.y);
        pen.lineTo(b.x, b.y);
        pen.stroke();
      });
      layer.nodes.forEach((node, nodeIndex) => {
        const position = point(nodeIndex);
        const pulse = reduced ? 1.4 : 1.2 + Math.sin(time / 1400 + node.phase) * 0.35;
        pen.fillStyle = palette.node;
        pen.beginPath();
        pen.arc(position.x, position.y, pulse, 0, Math.PI * 2);
        pen.fill();
      });
      if (!reduced) {
        layer.sparks.forEach((spark) => {
          const [from, to] = spark.link;
          const progress = (time / 9000 + spark.offset) % 1;
          const a = point(from);
          const b = point(to);
          pen.fillStyle = palette.spark;
          pen.beginPath();
          pen.arc(a.x + (b.x - a.x) * progress, a.y + (b.y - a.y) * progress, 1.7, 0, Math.PI * 2);
          pen.fill();
        });
      }
    }
  }

  function loop(time: number) {
    if (running && !document.hidden) draw(time);
    frame = requestAnimationFrame(loop);
  }

  resize();
  draw(0);
  new ResizeObserver(() => { resize(); draw(0); }).observe(graph);
  new MutationObserver(() => draw(0)).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  if (reduced) {
    window.addEventListener("scroll", () => draw(0), { passive: true });
  } else {
    frame = requestAnimationFrame(loop);
  }
  window.addEventListener("pagehide", () => { running = false; cancelAnimationFrame(frame); });
</script>
